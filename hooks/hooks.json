{
  "description": "Reapply the saved Codex window opacity when a desktop session starts or resumes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "D:\\math_workplace\\temp-codex-transparent-bg\\scripts\\run-opacity.bat",
            "async": false,
            "timeout": 30,
            "statusMessage": "Applying Codex window opacity"
          }
        ]
      }
    ]
  }
}
