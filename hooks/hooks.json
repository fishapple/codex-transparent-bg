{
  "description": "Reapply the saved Codex window opacity when a desktop session starts or resumes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "true",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts\\Set-CodexWindowOpacity.ps1')\"",
            "async": true,
            "timeout": 20,
            "statusMessage": "Applying Codex window opacity"
          }
        ]
      }
    ]
  }
}
